// =============================================================================
// cosmos.config — Nextflow settings for running nf-core/mag on LUNARC COSMOS
//
// Used with:  -profile singularity -c workflow/05_assembly/cosmos.config
// Contains only cluster settings (no pipeline parameters; those go in the
// params file written by run_nfcore_mag.sh, as nf-core recommends).
// Values come from environment variables exported by run_nfcore_mag.sh,
// which reads them from config.sh.
// =============================================================================

process {
    executor       = 'slurm'
    // charge every nf-core task to the project allocation
    clusterOptions = "-A ${System.getenv('NF_SLURM_ACCOUNT')}"
    // Optional: run tasks on node-local disk. Enable only after checking the
    // size of $SNIC_TMP on COSMOS nodes (large assemblies need a lot of space).
    // scratch = '$SNIC_TMP'
}

executor {
    name            = 'slurm'
    queueSize       = (System.getenv('NFMAG_QUEUE_SIZE') ?: '20') as Integer  // jobs queued at once
    submitRateLimit = '10/1min'                                                // be gentle with the scheduler
    pollInterval    = '1 min'
}

singularity {
    enabled    = true
    autoMounts = true
    // keep container images in project storage (not $HOME) and reuse them
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR')
}

// CheckM sometimes fails at start-up with a Python multiprocessing socket
// error ("OSError: [Errno 98] Address already in use" -> EOFError). The
// error is transient (not caused by the data), so the task is retried.
process {
    withName: 'CHECKM_LINEAGEWF' {
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
    }
}

// MAG_DEPTHS_PLOT draws a heatmap of bin depths per sample. In nf-core/mag
// 2.5.1 it crashes when a sample has only one bin (empty distance matrix for
// clustering). It is a figure only, not used downstream, so its errors are
// ignored instead of stopping the run.
process {
    withName: 'MAG_DEPTHS_PLOT' {
        errorStrategy = 'ignore'
    }
}
